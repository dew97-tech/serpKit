# Egress proxy for Google (required for live runs)
# Canonical DataImpulse sticky: rotating transport + sessid pin (same IP ~30min).
#   PROXY_SERVER=gw.dataimpulse.com:823
#   PROXY_USERNAME_TEMPLATE={username}__cr.{country};sessid.{run_id}
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# Provider username templates, appended or full override. Canonical sticky is
# PROXY_USERNAME_TEMPLATE above; leave the two suffix templates empty unless
# your provider needs them (e.g. Bright Data -session-{run_id}).
# True port-sticky alternative: PROXY_SERVER=gw.dataimpulse.com:10001 with
# PROXY_USERNAME_TEMPLATE={username}__cr.{country};sessttl.25 (do NOT mix
# sessid on 10000+ ports or sessttl on 823/824).
PROXY_SESSION_TEMPLATE=
PROXY_TARGETING_TEMPLATE=
PROXY_USERNAME_TEMPLATE=

# Session/thread tuning (sticky window 25min < DataImpulse 30min pin)
# SESSION_REUSE=1 SESSION_TTL_S=1500 SESSION_QUERY_DELAY_S=8
# SESSION_IP_CHECK=1 SESSION_IP_CACHE_S=60 SESSION_MIDRUN_IP_CHECK=1
# PROXY_THREAD_BACKOFF_S=8 RUN_RETRY=1

# CAPTCHA solving (CapSolver)
CAPSOLVER_API_KEY=

# Optional proxy for solver API calls when the network blocks capsolver.com
CAPSOLVER_PROXY_SERVER=
CAPSOLVER_PROXY_USERNAME=
CAPSOLVER_PROXY_PASSWORD=
