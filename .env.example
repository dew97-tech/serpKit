# SERP KIT environment configuration. Copy to `.env` (gitignored) and fill.
# All values are optional; the service runs in mock mode without any of them.

# --- CAPTCHA solving (CapSolver) -------------------------------------------
# https://dashboard.capsolver.com — key from the dashboard.
CAPSOLVER_API_KEY=
SOLVE_MAX_PER_RUN=3
SOLVE_MIN_INTERVAL_S=5
SOLVE_TIMEOUT_S=130

# --- Session reuse (sticky IP + stored cookies) ------------------------------
# Reuse one residential IP + Google cookies while they work; rotate on TTL
# expiry or a blocked run. RUN_RETRY retries a blocked run once (fresh session).
# SESSION_IP_CHECK verifies the exit IP each run (silent proxy failover
# replaces dead peers mid-window — cookies must rotate with the IP).
SESSION_REUSE=1
SESSION_TTL_S=1500
SESSION_QUERY_DELAY_S=8
RUN_RETRY=1
SESSION_WARMUP=1
SESSION_IP_CHECK=1
# SESSION_DIR=.sessions
# Browser channel: default tries system "chrome" (real UA), falls back to
# Playwright's bundled "chromium". Force one with BROWSER_CHANNEL=chromium.
# BROWSER_CHANNEL=chrome
#
# DataImpulse sticky example (deterministic 25-min IP rotation aligned with
# SESSION_TTL_S): PROXY_SERVER=gw.dataimpulse.com:10000 and
# PROXY_USERNAME_TEMPLATE={username}__cr.{country};sessid.{run_id};sessttl.25
#
# Some corporate networks block capsolver.com (verified on this office
# network: TCP 443 timeout). Route CapSolver API calls through any HTTP proxy
# that can reach it — e.g. your Bright Data zone (non-search-engine target,
# so it is allowed):
#   CAPSOLVER_PROXY_SERVER=brd.superproxy.io:44445
#   CAPSOLVER_PROXY_USERNAME=brd-customer-...-zone-...
#   CAPSOLVER_PROXY_PASSWORD=...
CAPSOLVER_PROXY_SERVER=
CAPSOLVER_PROXY_USERNAME=
CAPSOLVER_PROXY_PASSWORD=

# --- Egress (optional IP-layer proxy) ---------------------------------------
# Generic form (works with any HTTP(S) proxy):
#   PROXY_SERVER=host:port
#   PROXY_USERNAME=...
#   PROXY_PASSWORD=...
# Bright Data aliases are accepted but NOT usable for Google targets
# (vendor policy — see docs/PROVIDERS.md; the scraper will warn and skip it):
#   BRIGHTDATA_PROXY_HOST=brd.superproxy.io
#   BRIGHTDATA_PROXY_PORT=44445
#   BRIGHTDATA_PROXY_USER=brd-customer-...-zone-...
#   BRIGHTDATA_PROXY_PASSWORD=...
#
# Sticky-session / geo suffix templates appended to the proxy username.
# Examples: Bright Data "-session-{run_id}" "-country-{country}"
#           DataImpulse "_session-{run_id}" "_country-{country}"
PROXY_SESSION_TEMPLATE=
PROXY_TARGETING_TEMPLATE=
# OR a full username template (takes precedence) for providers that need a
# different parameter order, e.g. DataImpulse:
#   PROXY_USERNAME_TEMPLATE={username}__cr.{country};sessid.{run_id}
PROXY_USERNAME_TEMPLATE=

# Evidence-only override for the Bright Data Google policy guard (Phase 0 test).
# ALLOW_BD_GOOGLE=1
